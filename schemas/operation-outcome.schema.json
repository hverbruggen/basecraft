{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OperationOutcome",
  "description": "Session-owned runtime view, independent of historical scientific `JobStatus`.",
  "type": "object",
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PublishedArtifact"
      }
    },
    "basecraft": {
      "description": "The basecraft version that wrote this file.",
      "type": "string"
    },
    "data": true,
    "effective_parameters": true,
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OperationError"
      }
    },
    "evidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "operation": {
      "type": "string"
    },
    "pins": {
      "$ref": "#/$defs/OperationPins"
    },
    "proposals": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProposalOutcome"
        },
        {
          "type": "null"
        }
      ]
    },
    "requested_parameters": true,
    "run_id": {
      "type": "string"
    },
    "schema": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "state": {
      "$ref": "#/$defs/RuntimeState"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "operation",
    "run_id",
    "state",
    "pins",
    "requested_parameters",
    "effective_parameters",
    "artifacts",
    "warnings",
    "errors",
    "basecraft"
  ],
  "$defs": {
    "OperationError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/OperationErrorCode"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message",
        "operation"
      ]
    },
    "OperationErrorCode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "io_error",
            "format_error",
            "unknown_format",
            "empty_document",
            "analysis_input_conflict",
            "evidence_check_incomplete",
            "save_decision_stale",
            "published_with_failure",
            "nothing_to_do",
            "record_names_repeat",
            "changed_on_disk",
            "wrong_document_kind",
            "unknown_document",
            "not_found",
            "damaged",
            "limit",
            "unsupported",
            "busy",
            "invalid_arguments",
            "incompatible_contract",
            "plugin_disabled",
            "plugin_unavailable",
            "plugin_changed",
            "permission_denied",
            "stale_revision",
            "output_conflict",
            "unsupported_input",
            "plugin_protocol_violation",
            "tool_failure",
            "cancelled",
            "timeout",
            "publication_incomplete",
            "evidence_incomplete"
          ]
        },
        {
          "description": "A save would drop fields a later basecraft wrote (D14).",
          "type": "string",
          "const": "newer_fields_dropped"
        },
        {
          "description": "The folder cannot hold recovery of unsaved edits; copy the file first.",
          "type": "string",
          "const": "read_only_folder"
        },
        {
          "description": "A choice the command needs and has no default for was not given (D1):\na setting, the project, or the display tree to draw on.",
          "type": "string",
          "const": "missing_choice"
        },
        {
          "description": "A setting the operation does not have.",
          "type": "string",
          "const": "unknown_setting"
        }
      ]
    },
    "OperationPins": {
      "type": "object",
      "properties": {
        "descriptor_digest": {
          "type": "string"
        },
        "generation": {
          "type": "string"
        },
        "package_digest": {
          "type": "string"
        }
      },
      "required": [
        "generation",
        "package_digest",
        "descriptor_digest"
      ]
    },
    "ProposalOutcome": {
      "type": "object",
      "properties": {
        "applied": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "document": {
          "type": [
            "string",
            "null"
          ]
        },
        "rejected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "applied",
        "rejected"
      ]
    },
    "PublishedArtifact": {
      "type": "object",
      "properties": {
        "digest": {
          "description": "Algorithm-qualified digest, e.g. b3:hex; never reinterpret old hashes.",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      },
      "required": [
        "role",
        "path",
        "digest"
      ]
    },
    "RuntimeState": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "cancelling",
        "finalizing",
        "completed",
        "failed",
        "cancelled",
        "interrupted",
        "partial"
      ]
    }
  }
}
