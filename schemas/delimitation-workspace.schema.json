{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DelimitationWorkspace",
  "type": "object",
  "properties": {
    "exchange_fields": {
      "description": "Unsupported interchange fields retained verbatim when possible.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Hypothesis"
      }
    },
    "name": {
      "type": "string"
    },
    "specimens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Specimen"
      }
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "view": {
      "$ref": "#/$defs/DelimitationView",
      "default": {
        "display_tree": null,
        "selected": [],
        "visible": []
      }
    }
  },
  "required": [
    "version",
    "name",
    "specimens",
    "hypotheses"
  ],
  "$defs": {
    "DelimitationView": {
      "type": "object",
      "properties": {
        "display_tree": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "visible": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "visible",
        "selected"
      ]
    },
    "Group": {
      "type": "object",
      "properties": {
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "color": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "individual_scores": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Score"
            }
          },
          "default": {}
        },
        "label": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "scores": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Score"
          }
        }
      },
      "required": [
        "id",
        "label",
        "color",
        "members"
      ]
    },
    "Hypothesis": {
      "type": "object",
      "properties": {
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Group"
          }
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/HypothesisOrigin"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "scores": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Score"
          }
        },
        "unassigned": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "name",
        "origin",
        "groups",
        "unassigned",
        "provenance"
      ]
    },
    "HypothesisOrigin": {
      "type": "string",
      "enum": [
        "manual",
        "imported",
        "inferred",
        "derived",
        "manual_cut"
      ]
    },
    "JobStatus": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "cancelled",
        "unavailable"
      ]
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "analysis_tree": {
          "type": [
            "string",
            "null"
          ]
        },
        "diagnostics": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "haplotypes": {
          "description": "Representative ID to original specimen IDs; never likelihood weights.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "default": {}
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "method": {
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "string"
        },
        "workers": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "method",
        "version"
      ]
    },
    "Score": {
      "type": "object",
      "properties": {
        "interpretation": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "scale": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "value",
        "method",
        "scale",
        "interpretation"
      ]
    },
    "Specimen": {
      "description": "IDs refer to source records, never current tree row positions.",
      "type": "object",
      "properties": {
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      },
      "required": [
        "id",
        "label"
      ]
    }
  }
}
