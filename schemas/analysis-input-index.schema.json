{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IndexFile",
  "description": "Current source catalogue. Per-source shards hold the affected store closure.",
  "type": "object",
  "properties": {
    "checksum": {
      "type": "string"
    },
    "value": {
      "$ref": "#/$defs/AnalysisInputIndex"
    }
  },
  "required": [
    "checksum",
    "value"
  ],
  "$defs": {
    "AnalysisInputIndex": {
      "description": "Local source and store locations, without unrelated run records.",
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stores": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema_version",
        "stores",
        "sources"
      ]
    }
  }
}
