{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_ReportSourceMapEntry",
  "type": "array",
  "items": {
    "$ref": "#/$defs/ReportSourceMapEntry"
  },
  "$defs": {
    "ReportSourceMapEntry": {
      "description": "One paragraph's activity references in a report's source map.",
      "type": "object",
      "properties": {
        "activities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paragraph": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "paragraph",
        "activities"
      ]
    }
  }
}
