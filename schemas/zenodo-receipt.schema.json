{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZenodoReceipt",
  "type": "object",
  "properties": {
    "draft_id": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ZenodoFile"
      }
    },
    "message": {
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/ZenodoMetadata"
    },
    "schema": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "selection": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ZenodoStatus"
    },
    "uploaded": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "url": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "status",
    "service",
    "selection",
    "metadata",
    "url",
    "files",
    "uploaded",
    "message"
  ],
  "$defs": {
    "ZenodoCreator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "ZenodoFile": {
      "type": "object",
      "properties": {
        "md5": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "size",
        "sha256",
        "md5"
      ]
    },
    "ZenodoMetadata": {
      "type": "object",
      "properties": {
        "access_right": {
          "type": "string"
        },
        "creators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ZenodoCreator"
          }
        },
        "description": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "upload_type": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "creators",
        "upload_type",
        "access_right",
        "license"
      ]
    },
    "ZenodoStatus": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "draft_ready",
            "creation_unknown",
            "upload_failed",
            "cancelled",
            "uploading"
          ]
        },
        {
          "type": "string"
        }
      ]
    }
  }
}
