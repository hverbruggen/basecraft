{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunRecord",
  "description": "A run folder's `execution.json`: what ran, on what and how. Paths are\nrelative to the run folder, so the folder can move with its project; an\ninput outside the folder has a path that starts with `..`. The request\nitself, normalised the same way, is the folder's `request.json`.",
  "type": "object",
  "properties": {
    "basecraft": {
      "description": "The basecraft version that wrote this file.",
      "type": "string"
    },
    "cpu_threads": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "descriptor_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_parameters": true,
    "environment": {
      "description": "Where the plugin ran.",
      "$ref": "#/$defs/RunEnvironment"
    },
    "execution": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "executor": {
      "type": "string"
    },
    "initiator": {
      "description": "Caller label, such as `gui` or `mcp`.",
      "type": "string"
    },
    "inputs": {
      "description": "Submitted inputs by binding.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/InvocationInputEvidence"
        }
      }
    },
    "operation": {
      "type": "string"
    },
    "package_digest": {
      "description": "The plugin package and its operation descriptor, by content. Null for\nbasecraft's own tools, such as a Sanger stage.",
      "type": [
        "string",
        "null"
      ]
    },
    "package_version": {
      "type": "string"
    },
    "process_instance": {
      "type": "string"
    },
    "schema": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "stderr": {
      "type": "string"
    },
    "stdout": {
      "type": "string"
    },
    "tool": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolInfo"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "operation",
    "package_version",
    "environment",
    "initiator",
    "executor",
    "process_instance",
    "inputs",
    "effective_parameters",
    "cpu_threads",
    "stdout",
    "stderr",
    "basecraft"
  ],
  "$defs": {
    "ExecutionInfo": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "description": "Only scientific environment settings, never the whole process environment.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "methods": {
          "description": "Frozen scientific description and citations supplied by the plugin.",
          "anyOf": [
            {
              "$ref": "#/$defs/MethodsInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "methods_template": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "preprocessing": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "resolved_parameters": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        }
      },
      "required": [
        "argv"
      ]
    },
    "InvocationInputEvidence": {
      "description": "Where a submitted input came from. In the invocation context its paths\nfollow the context's rule; in the run record they are relative to the run\nfolder.",
      "type": "object",
      "properties": {
        "original_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_directory": {
          "type": "string"
        },
        "source_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "submitted_hash": {
          "type": "string"
        },
        "transformation": {
          "type": "string"
        }
      },
      "required": [
        "submitted_hash",
        "transformation",
        "run_directory"
      ]
    },
    "MethodsInfo": {
      "type": "object",
      "properties": {
        "citations": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "description"
      ]
    },
    "RunEnvironment": {
      "description": "What a run needs to be repeated in the same environment. No paths.",
      "type": "object",
      "properties": {
        "interpreter": {
          "description": "As the plugin reported it, such as \"Python 3.12.4\". Null for host\nworkflows and plugins that run no interpreter.",
          "type": [
            "string",
            "null"
          ]
        },
        "runtime": {
          "description": "The managed runtime the plugin ran in; null for the system Python and\nfor host workflows.",
          "anyOf": [
            {
              "$ref": "#/$defs/RunRuntime"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RunRuntime": {
      "description": "A managed plugin runtime: the conda specification it was made from and\nwhat was installed, by content.",
      "type": "object",
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "description": "Conda packages and their version constraints.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "executable_digests": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "lock_digest": {
          "description": "Hash of the solved Pixi lock.",
          "type": "string"
        },
        "manifest_digest": {
          "type": "string"
        },
        "pypi_dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "reported_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "channels",
        "dependencies",
        "pypi_dependencies",
        "lock_digest",
        "manifest_digest",
        "reported_versions",
        "executable_digests"
      ]
    },
    "ToolInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    }
  }
}
