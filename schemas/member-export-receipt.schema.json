{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemberExportReceipt",
  "description": "Identity of the synced pending file, recorded before no-replace promotion.",
  "type": "object",
  "properties": {
    "basecraft": {
      "description": "The basecraft version that wrote this file.",
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "device": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "hash": {
      "type": "string"
    },
    "inode": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "schema": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "size": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "schema",
    "destination",
    "hash",
    "device",
    "inode",
    "size",
    "basecraft"
  ]
}
