{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SubmissionEdit",
  "description": "One atomic submission edit.",
  "oneOf": [
    {
      "description": "Select the source alignment (or accept a changed one).",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "set_source"
        },
        "source": {
          "$ref": "#/$defs/SourceAlignment"
        }
      },
      "required": [
        "action",
        "source"
      ]
    },
    {
      "description": "Set the decision of these rows.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "set_rows"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RowDecision"
          }
        }
      },
      "required": [
        "action",
        "rows"
      ]
    },
    {
      "description": "Confirm the selection fingerprint returned by submission review.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "confirm_selection"
        },
        "selection_hash": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "selection_hash"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "set_batch"
        },
        "batch": {
          "$ref": "#/$defs/BatchSettings"
        }
      },
      "required": [
        "action",
        "batch"
      ]
    },
    {
      "description": "Save annotation settings with type-specific drafts. Legacy `set_batch`\nretains its historical meaning so previously saved histories replay exactly.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "set_batch_draft"
        },
        "batch": {
          "$ref": "#/$defs/BatchSettings"
        }
      },
      "required": [
        "action",
        "batch"
      ]
    },
    {
      "description": "Confirm or choose reading frames; `clear` forgets choices.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "set_frames"
        },
        "clear": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "frames": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/FrameChoice"
          }
        }
      },
      "required": [
        "action"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "set_export"
        },
        "export": {
          "$ref": "#/$defs/ExportSettings"
        }
      },
      "required": [
        "action",
        "export"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "set_publication"
        },
        "publication": {
          "$ref": "#/$defs/Publication"
        }
      },
      "required": [
        "action",
        "publication"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "set_accession_policy"
        },
        "policy": {
          "$ref": "#/$defs/AccessionPolicy"
        }
      },
      "required": [
        "action",
        "policy"
      ]
    },
    {
      "description": "Both citations in one undoable change. Disabled custom publication values are retained.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "set_details"
        },
        "publication": {
          "$ref": "#/$defs/Publication"
        },
        "publication_differs": {
          "type": "boolean"
        },
        "submission": {
          "$ref": "#/$defs/Publication"
        }
      },
      "required": [
        "action",
        "submission",
        "publication",
        "publication_differs"
      ]
    },
    {
      "description": "Apply a reviewed rule. The shared ops boundary checks this plan against live inputs.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "apply_inclusion"
        },
        "plan": {
          "$ref": "#/$defs/InclusionPlan"
        }
      },
      "required": [
        "action",
        "plan"
      ]
    },
    {
      "description": "Retain the mapping after writing a submission package.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "record_export"
        },
        "mapping": {
          "$ref": "#/$defs/ExportMapping"
        }
      },
      "required": [
        "action",
        "mapping"
      ]
    },
    {
      "description": "Record accessions returned by the archive.",
      "type": "object",
      "properties": {
        "accessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccessionEntry"
          }
        },
        "action": {
          "type": "string",
          "const": "set_accessions"
        }
      },
      "required": [
        "action",
        "accessions"
      ]
    },
    {
      "description": "A source row was renamed: its decision, frame, rule and accession follow it.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "rename_record"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "from",
        "to"
      ]
    }
  ],
  "$defs": {
    "AccessionEntry": {
      "type": "object",
      "properties": {
        "accession": {
          "description": "Accession, with its version when the archive gave one.",
          "type": "string"
        },
        "record": {
          "type": "string"
        }
      },
      "required": [
        "record",
        "accession"
      ]
    },
    "AccessionPolicy": {
      "description": "Legacy suggestions are retained on old documents. Configured sources prevent\nspecimen identifiers elsewhere in a name from influencing inclusion suggestions.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "policy": {
              "type": "string",
              "const": "legacy_heuristic"
            }
          },
          "required": [
            "policy"
          ]
        },
        {
          "type": "object",
          "properties": {
            "include_metadata": {
              "type": "boolean"
            },
            "input": {
              "anyOf": [
                {
                  "$ref": "#/$defs/IdentifierSource"
                },
                {
                  "type": "null"
                }
              ]
            },
            "policy": {
              "type": "string",
              "const": "configured"
            }
          },
          "required": [
            "policy",
            "include_metadata"
          ]
        }
      ]
    },
    "Author": {
      "type": "object",
      "properties": {
        "first": {
          "type": "string"
        },
        "last": {
          "type": "string"
        },
        "middle": {
          "description": "Middle names or initials, without the first name's, such as `Marie` or `M.R.`.\nBare uppercase runs (`MR`) retain their legacy initials meaning; uppercase full names are ambiguous.",
          "type": "string"
        }
      },
      "required": [
        "first",
        "last"
      ]
    },
    "BatchSettings": {
      "description": "Settings shared by every record of the batch.",
      "type": "object",
      "properties": {
        "ends": {
          "$ref": "#/$defs/EndPolicy",
          "default": "auto"
        },
        "genetic_code": {
          "description": "NCBI genetic code (translation table) number.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "marker": {
          "$ref": "#/$defs/Marker"
        },
        "mol_type": {
          "$ref": "#/$defs/MolType",
          "default": "genomic_dna"
        },
        "organelle": {
          "description": "The organelle the marker is from; none for nuclear markers.",
          "anyOf": [
            {
              "$ref": "#/$defs/Organelle"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "marker",
        "genetic_code"
      ]
    },
    "Decision": {
      "description": "What to do with a row.",
      "oneOf": [
        {
          "description": "A newly generated sequence, exported for submission.",
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "new"
            }
          },
          "required": [
            "decision"
          ]
        },
        {
          "description": "Already in an archive (a downloaded reference, or submitted\nbefore); not exported.",
          "type": "object",
          "properties": {
            "accession": {
              "type": "string"
            },
            "decision": {
              "type": "string",
              "const": "existing"
            }
          },
          "required": [
            "decision",
            "accession"
          ]
        },
        {
          "description": "Left out of the submission.",
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "exclude"
            }
          },
          "required": [
            "decision"
          ]
        }
      ]
    },
    "EndPolicy": {
      "description": "How the feature's ends are marked.",
      "oneOf": [
        {
          "description": "Coding markers: an end is complete when it has a start (5') or stop\n(3') codon in frame. Other markers: both ends partial.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "Both ends partial.",
          "type": "string",
          "const": "partial"
        },
        {
          "description": "Both ends complete.",
          "type": "string",
          "const": "complete"
        }
      ]
    },
    "ExportMapping": {
      "description": "Retained identities for interpreting archive returns after later selection edits.",
      "type": "object",
      "properties": {
        "records": {
          "description": "Submitted `SeqID` to original biological record name.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceAlignment"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "records"
      ]
    },
    "ExportSettings": {
      "type": "object",
      "properties": {
        "trim_terminal_unknown": {
          "description": "Remove runs of unknown bases (N, ?) at the ends of each record.\nThe trimmed lengths are recorded in the coordinate map.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "FrameChoice": {
      "description": "A reading frame the user reviewed for one record.",
      "type": "object",
      "properties": {
        "codon_start": {
          "description": "1, 2 or 3: the first base of the first complete codon.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "record": {
          "type": "string"
        }
      },
      "required": [
        "record",
        "codon_start"
      ]
    },
    "IdentifierSource": {
      "description": "Identifier fields use the same literal splitting primitive as metadata header imports.\nSubmission rules always use the FASTA identifier, never the full description header.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "identifier"
            }
          },
          "required": [
            "source"
          ]
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "separator": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "const": "field"
            }
          },
          "required": [
            "source",
            "separator",
            "index"
          ]
        }
      ]
    },
    "InclusionAction": {
      "type": "string",
      "enum": [
        "include",
        "exclude",
        "unchanged"
      ]
    },
    "InclusionPlan": {
      "type": "object",
      "properties": {
        "changed": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "fingerprint": {
          "description": "Hash of target content, source bytes and metadata evidence; recomputed before apply.",
          "type": "string"
        },
        "included": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "matching": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "preserved": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InclusionPreviewRow"
          }
        },
        "rule": {
          "$ref": "#/$defs/InclusionRule"
        },
        "unresolved": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "rule",
        "fingerprint",
        "rows",
        "matching",
        "unresolved",
        "preserved",
        "changed",
        "included"
      ]
    },
    "InclusionPreviewRow": {
      "type": "object",
      "properties": {
        "current": {
          "$ref": "#/$defs/Decision"
        },
        "extracted": {
          "type": [
            "string",
            "null"
          ]
        },
        "matched": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "preserved_manual": {
          "type": "boolean"
        },
        "proposed": {
          "$ref": "#/$defs/Decision"
        },
        "reason": {
          "type": "string"
        },
        "record": {
          "type": "string"
        }
      },
      "required": [
        "record",
        "reason",
        "preserved_manual",
        "current",
        "proposed"
      ]
    },
    "InclusionRule": {
      "type": "object",
      "properties": {
        "case_sensitive": {
          "type": "boolean",
          "default": false
        },
        "input": {
          "$ref": "#/$defs/IdentifierSource"
        },
        "matching": {
          "$ref": "#/$defs/InclusionAction"
        },
        "mode": {
          "$ref": "#/$defs/MatchMode"
        },
        "name": {
          "type": "string"
        },
        "nonmatching": {
          "$ref": "#/$defs/InclusionAction"
        },
        "override_manual": {
          "type": "boolean",
          "default": false
        },
        "pattern": {
          "type": "string"
        },
        "trim": {
          "type": "boolean",
          "default": false
        },
        "unresolved": {
          "$ref": "#/$defs/InclusionAction",
          "default": "unchanged"
        }
      },
      "required": [
        "name",
        "input",
        "mode",
        "pattern",
        "matching",
        "nonmatching"
      ]
    },
    "ItsComponent": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "ITS1",
            "5.8S",
            "ITS2"
          ]
        },
        {
          "description": "Small subunit (18S) ribosomal RNA.",
          "type": "string",
          "const": "SSU"
        },
        {
          "description": "Large subunit (28S) ribosomal RNA.",
          "type": "string",
          "const": "LSU"
        }
      ]
    },
    "Marker": {
      "description": "The marker type, which decides the one feature each record gets.",
      "oneOf": [
        {
          "description": "A protein-coding gene: a `gene` and a `CDS` feature.",
          "type": "object",
          "properties": {
            "gene": {
              "description": "Gene symbol, such as `rbcL`; may be empty.",
              "type": "string",
              "default": ""
            },
            "kind": {
              "type": "string",
              "const": "coding"
            },
            "product": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "product"
          ]
        },
        {
          "description": "A ribosomal RNA gene, such as `18S ribosomal RNA`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rrna"
            },
            "product": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "product"
          ]
        },
        {
          "description": "The ITS region: one `misc_RNA` with a note listing the components\npresent. Internal boundaries are not annotated.",
          "type": "object",
          "properties": {
            "components": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ItsComponent"
              }
            },
            "kind": {
              "type": "string",
              "const": "its"
            }
          },
          "required": [
            "kind",
            "components"
          ]
        },
        {
          "description": "A non-coding region, such as an intergenic spacer: one\n`misc_feature` with this description as its note.",
          "type": "object",
          "properties": {
            "description": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "spacer"
            }
          },
          "required": [
            "kind",
            "description"
          ]
        }
      ]
    },
    "MatchMode": {
      "type": "string",
      "enum": [
        "exact",
        "contains",
        "starts",
        "ends",
        "wildcard",
        "regex"
      ]
    },
    "MolType": {
      "type": "string",
      "enum": [
        "genomic_dna",
        "genomic_rna"
      ]
    },
    "Organelle": {
      "type": "string",
      "enum": [
        "mitochondrion",
        "chloroplast",
        "plastid",
        "apicoplast",
        "chromoplast",
        "cyanelle",
        "kinetoplast",
        "nucleomorph"
      ]
    },
    "Publication": {
      "description": "The publication the sequences belong to, written to the `.sbt`.",
      "type": "object",
      "properties": {
        "authors": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Author"
          }
        },
        "title": {
          "type": "string",
          "default": ""
        }
      }
    },
    "RowDecision": {
      "description": "What to do with a row.",
      "type": "object",
      "properties": {
        "record": {
          "description": "The alignment row name (FASTA ID).",
          "type": "string"
        }
      },
      "oneOf": [
        {
          "description": "A newly generated sequence, exported for submission.",
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "new"
            }
          },
          "required": [
            "decision"
          ]
        },
        {
          "description": "Already in an archive (a downloaded reference, or submitted\nbefore); not exported.",
          "type": "object",
          "properties": {
            "accession": {
              "type": "string"
            },
            "decision": {
              "type": "string",
              "const": "existing"
            }
          },
          "required": [
            "decision",
            "accession"
          ]
        },
        {
          "description": "Left out of the submission.",
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "exclude"
            }
          },
          "required": [
            "decision"
          ]
        }
      ],
      "required": [
        "record"
      ]
    },
    "SourceAlignment": {
      "description": "An alignment file inside the project and the BLAKE3 hash of the bytes\nthe submission was prepared from. A different file content is refused\nuntil the source is selected again.",
      "type": "object",
      "properties": {
        "document": {
          "description": "Project-relative path.",
          "type": "string"
        },
        "hash": {
          "type": "string"
        }
      },
      "required": [
        "document",
        "hash"
      ]
    }
  }
}
