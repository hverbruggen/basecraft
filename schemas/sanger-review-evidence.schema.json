{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewEvidence",
  "type": "object",
  "properties": {
    "placement": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewSupport"
        },
        {
          "type": "null"
        }
      ]
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReviewSource"
      }
    }
  },
  "required": [
    "schema_version",
    "runs",
    "sources"
  ],
  "$defs": {
    "FileStamp": {
      "description": "Cheap change signal captured during an existing verified read. Matching time\nand length alone do not prove content identity.",
      "type": "object",
      "properties": {
        "device": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "inode": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "modified_nanos": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "modified_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "size",
        "modified_seconds",
        "modified_nanos"
      ]
    },
    "InputReference": {
      "type": "object",
      "properties": {
        "hash": {
          "description": "Source bytes hash reused from the verified document read.",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "stamp": {
          "$ref": "#/$defs/FileStamp"
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "stamp",
        "hash"
      ]
    },
    "ReviewSource": {
      "type": "object",
      "properties": {
        "ledger": {
          "type": [
            "string",
            "null"
          ]
        },
        "original": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "original",
        "sha256",
        "path"
      ]
    },
    "ReviewSupport": {
      "type": "object",
      "properties": {
        "hash": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "hash"
      ]
    }
  }
}
