{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publication",
  "type": "object",
  "properties": {
    "basecraft": {
      "description": "The basecraft version that wrote this file.",
      "type": "string"
    },
    "completeness": {
      "$ref": "#/$defs/Completeness"
    },
    "created": {
      "type": "string"
    },
    "effective_edits": {
      "description": "Operations actually contributing to this revision, in causal order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/EditActivity"
      }
    },
    "events": {
      "description": "Full chronology, including undo/redo and abandoned branches, as journal\nentries (journal-entry.schema.json) without the checksum envelope."
    },
    "id": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactRevision"
      }
    },
    "origin": {
      "type": "string"
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactRevision"
      }
    },
    "parent_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "report_template_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "session": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "session",
    "parents",
    "created",
    "origin",
    "inputs",
    "outputs",
    "events",
    "effective_edits",
    "completeness",
    "report_template_version",
    "basecraft"
  ],
  "$defs": {
    "ArtifactRevision": {
      "type": "object",
      "properties": {
        "hash": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "logical_name": {
          "type": "string"
        },
        "reference": {
          "description": "Original disk evidence. Relative to the publication bundle; never a write destination.",
          "anyOf": [
            {
              "$ref": "#/$defs/InputReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "retained": {
          "description": "Relative path inside the bundle; None means bytes are unavailable.",
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "logical_name",
        "hash",
        "size"
      ]
    },
    "Completeness": {
      "type": "object",
      "properties": {
        "ancestry_known": {
          "type": "boolean"
        },
        "execution_specification_available": {
          "type": "boolean"
        },
        "input_bytes_available": {
          "type": "boolean"
        },
        "replay_verified": {
          "description": "Saving is not a replay verification.",
          "type": "boolean"
        }
      },
      "required": [
        "ancestry_known",
        "input_bytes_available",
        "execution_specification_available",
        "replay_verified"
      ]
    },
    "EditActivity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "operation": {
          "description": "A journal operation; its shape is defined once, in journal-entry.schema.json."
        }
      },
      "required": [
        "id",
        "operation"
      ]
    },
    "FileStamp": {
      "description": "Cheap change signal captured during an existing verified read. Matching time\nand length alone do not prove content identity.",
      "type": "object",
      "properties": {
        "device": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "inode": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "modified_nanos": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "modified_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "size",
        "modified_seconds",
        "modified_nanos"
      ]
    },
    "InputReference": {
      "type": "object",
      "properties": {
        "hash": {
          "description": "Source bytes hash reused from the verified document read.",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "stamp": {
          "$ref": "#/$defs/FileStamp"
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "stamp",
        "hash"
      ]
    }
  }
}
