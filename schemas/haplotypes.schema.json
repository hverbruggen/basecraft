{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Haplotypes",
  "type": "object",
  "properties": {
    "input_hash": {
      "type": "string"
    },
    "members": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      }
    },
    "original_count": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "policy": {
      "type": "string"
    },
    "unique": {
      "type": "array",
      "items": {
        "type": "array",
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ]
      }
    }
  },
  "required": [
    "policy",
    "input_hash",
    "original_count",
    "unique",
    "members"
  ]
}
