{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OperationContract",
  "type": "object",
  "properties": {
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OperationDescriptor"
      }
    },
    "schema": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "operations"
  ],
  "$defs": {
    "Alphabet": {
      "type": "string",
      "enum": [
        "nucleotide",
        "protein"
      ]
    },
    "ArtifactVisibility": {
      "type": "string",
      "enum": [
        "result",
        "supporting"
      ]
    },
    "BranchLengths": {
      "type": "string",
      "enum": [
        "substitutions",
        "time"
      ]
    },
    "Effects": {
      "type": "object",
      "properties": {
        "artifact_write": {
          "type": "boolean"
        },
        "document_write": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "document_write",
        "artifact_write"
      ]
    },
    "ExecutionFamily": {
      "type": "string",
      "enum": [
        "file_analysis",
        "sequence_proposal"
      ]
    },
    "HostServices": {
      "type": "object",
      "properties": {
        "bootstrap_exports": {
          "type": "boolean"
        },
        "caller": {
          "type": [
            "string",
            "null"
          ]
        },
        "caller_engine": {
          "description": "Program a caller service runs. The host finds it through\n`BASECRAFT_<PROGRAM>`, the plugin runtime, then PATH, and pins its hash.",
          "type": [
            "string",
            "null"
          ]
        },
        "lifecycle": {
          "description": "Cooperative cancellation and receipt rules for a bundled remote service.",
          "anyOf": [
            {
              "$ref": "#/$defs/LifecyclePolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "query_preparation": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueryPreparation"
            },
            {
              "type": "null"
            }
          ]
        },
        "retained_query_transformation": {
          "type": [
            "string",
            "null"
          ]
        },
        "species_workspace": {
          "type": "boolean"
        },
        "tree_support": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TreeSupportRule"
          }
        },
        "verify_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "InputBinding": {
      "type": "object",
      "properties": {
        "alphabets": {
          "description": "Residue alphabets the operation accepts. Empty accepts any. The host\nrefuses other alignments before launch.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Alphabet"
          }
        },
        "max": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "media_type": {
          "type": "string"
        },
        "min": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "retain": {
          "description": "Preserve original and submitted bytes when results refer to input paths.\nApplied by the shared runner equally for GUI, CLI, Python and MCP.",
          "type": "boolean"
        },
        "view": {
          "$ref": "#/$defs/InputView"
        }
      },
      "additionalProperties": false,
      "required": [
        "view",
        "media_type",
        "min",
        "max"
      ]
    },
    "InputView": {
      "type": "string",
      "enum": [
        "bytes",
        "aligned_fasta",
        "ungapped_fasta",
        "newick",
        "sequence_snapshot"
      ]
    },
    "LifecyclePolicy": {
      "type": "string",
      "enum": [
        "external_submission",
        "retained_receipt",
        "remote_draft"
      ]
    },
    "Needs": {
      "description": "What an operation needs from the host besides its inputs.",
      "type": "object",
      "properties": {
        "contact_email": {
          "description": "Parameter the host fills with the user's contact email when the caller\nleaves it out.",
          "type": [
            "string",
            "null"
          ]
        },
        "cpu_parameters": {
          "description": "Parameters that receive the CPU threads granted to the run.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "credentials": {
          "description": "Credential name -> environment variable the plugin reads. A need, never\npermission: an installed package needs a grant bound to its digest; a\nbundled package receives the credential from the user's environment.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "workflow_stages": {
          "description": "Workflow stage name -> registered operation id, including major version.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "OperationDescriptor": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "effects": {
          "$ref": "#/$defs/Effects"
        },
        "family": {
          "$ref": "#/$defs/ExecutionFamily"
        },
        "host": {
          "description": "Services the host runs around a bundled plugin.",
          "anyOf": [
            {
              "$ref": "#/$defs/HostServices"
            },
            {
              "type": "null"
            }
          ]
        },
        "host_workflow": {
          "description": "A workflow the host runs itself from the stages in `needs`.",
          "type": [
            "string",
            "null"
          ]
        },
        "implementation": {
          "type": "string"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/InputBinding"
          },
          "default": {}
        },
        "name": {
          "type": "string"
        },
        "needs": {
          "$ref": "#/$defs/Needs"
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/OutputBinding"
          },
          "default": {}
        },
        "parameters": true,
        "presentation": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": true,
        "title": {
          "type": "string"
        },
        "version": {
          "description": "Semantic version; breaking behavior/default changes require a new major.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "implementation",
        "title",
        "description",
        "family",
        "parameters",
        "result",
        "effects"
      ]
    },
    "OutputBinding": {
      "type": "object",
      "properties": {
        "collection": {
          "description": "A collection is allocated one directory; members remain relative to it.",
          "type": "boolean",
          "default": false
        },
        "facts": {
          "description": "Facts the host writes into the result's companion file.",
          "$ref": "#/$defs/OutputFacts"
        },
        "max": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "media_type": {
          "type": "string"
        },
        "min": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "primary": {
          "description": "The collection member that holds the main result, such as `tree.nwk`.",
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "$ref": "#/$defs/ArtifactVisibility"
        }
      },
      "additionalProperties": false,
      "required": [
        "media_type",
        "min",
        "max",
        "visibility"
      ]
    },
    "OutputFacts": {
      "description": "Facts an output declares about itself. The host writes them into the\nresult's companion file (lane facts' writer, once it exists).",
      "type": "object",
      "properties": {
        "alphabet": {
          "anyOf": [
            {
              "$ref": "#/$defs/Alphabet"
            },
            {
              "type": "null"
            }
          ]
        },
        "branch_lengths": {
          "anyOf": [
            {
              "$ref": "#/$defs/BranchLengths"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ParameterCondition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "parameter": {
              "type": "string"
            },
            "test": {
              "type": "string",
              "const": "equals"
            },
            "value": true
          },
          "additionalProperties": false,
          "required": [
            "test",
            "parameter",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "parameter": {
              "type": "string"
            },
            "test": {
              "type": "string",
              "const": "positive"
            }
          },
          "additionalProperties": false,
          "required": [
            "test",
            "parameter"
          ]
        }
      ]
    },
    "QueryPreparation": {
      "type": "string",
      "enum": [
        "blast"
      ]
    },
    "SupportKind": {
      "description": "Scientific support semantics supplied by a producer, never guessed from its name.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "unknown",
            "bootstrap",
            "probability"
          ]
        },
        {
          "description": "Percentage support from a method other than ordinary bootstrap.",
          "type": "string",
          "const": "percentage"
        }
      ]
    },
    "TreeSupportRule": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/SupportKind"
        },
        "name": {
          "type": "string"
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParameterCondition"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ]
    }
  }
}
