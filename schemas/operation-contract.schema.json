{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OperationContract",
  "type": "object",
  "properties": {
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OperationDescriptor"
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/QueryDescriptor"
      }
    },
    "schema": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "operations"
  ],
  "$defs": {
    "Alphabet": {
      "description": "The letters a sequence or alignment is written in.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "dna",
            "rna",
            "protein"
          ]
        },
        {
          "description": "No letters to judge by: gaps, N, X and ? only.",
          "type": "string",
          "const": "unknown"
        },
        {
          "description": "A guess only: a few protein-only letters, 1% or fewer. The user has\nto say what the sequence is before anything that needs it runs.",
          "type": "string",
          "const": "undetermined"
        },
        {
          "description": "A document only: its sequences are not all of one kind.",
          "type": "string",
          "const": "mixed"
        }
      ]
    },
    "ArtifactVisibility": {
      "type": "string",
      "enum": [
        "result",
        "supporting"
      ]
    },
    "BranchLengths": {
      "description": "What a tree's branch lengths measure.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "unknown"
          ]
        },
        {
          "description": "Expected substitutions per site.",
          "type": "string",
          "const": "substitutions"
        },
        {
          "description": "Time with no unit: the root is 1, or depths are only comparable.",
          "type": "string",
          "const": "relative_time"
        },
        {
          "description": "Time in the stated unit, such as \"Ma\".",
          "type": "object",
          "properties": {
            "absolute_time": {
              "type": "object",
              "properties": {
                "unit": {
                  "type": "string"
                }
              },
              "required": [
                "unit"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "absolute_time"
          ]
        }
      ]
    },
    "CallerKind": {
      "type": "string",
      "enum": [
        "single_trace"
      ]
    },
    "Effects": {
      "type": "object",
      "properties": {
        "artifact_write": {
          "type": "boolean"
        },
        "document_write": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "document_write",
        "artifact_write"
      ]
    },
    "ExecutionFamily": {
      "type": "string",
      "enum": [
        "file_analysis",
        "sequence_proposal"
      ]
    },
    "HostServices": {
      "type": "object",
      "properties": {
        "caller": {
          "description": "The operation is a base caller the Sanger review asks for alternative\ncalls. Its contract answers the `engine` query with the program's name\nand SHA-256, and its primary output is the draft.",
          "anyOf": [
            {
              "$ref": "#/$defs/CallerKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "remote": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemoteService"
            },
            {
              "type": "null"
            }
          ]
        },
        "species_workspace": {
          "description": "The result holds species hypotheses for the target workspace.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "InputBinding": {
      "type": "object",
      "properties": {
        "alphabets": {
          "description": "Residue alphabets the operation accepts. Empty accepts any. The host\nrefuses other documents before launch, and undetermined or mixed ones\nuntil the user states the alphabet (D12).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Alphabet"
          }
        },
        "max": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "media_type": {
          "type": "string"
        },
        "min": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "retain": {
          "description": "Preserve original and submitted bytes when results refer to input paths.\nApplied by the shared runner equally for GUI, CLI, Python and MCP.",
          "type": "boolean"
        },
        "verify": {
          "description": "Check the input's retained evidence before the run, as for a reused\ndistance cache.",
          "type": "boolean"
        },
        "view": {
          "$ref": "#/$defs/InputView"
        }
      },
      "additionalProperties": false,
      "required": [
        "view",
        "media_type",
        "min",
        "max"
      ]
    },
    "InputView": {
      "type": "string",
      "enum": [
        "bytes",
        "aligned_fasta",
        "ungapped_fasta",
        "newick",
        "sequence_snapshot"
      ]
    },
    "LifecyclePolicy": {
      "type": "string",
      "enum": [
        "external_submission",
        "retained_receipt",
        "remote_draft"
      ]
    },
    "Needs": {
      "description": "What an operation needs from the host besides its inputs.",
      "type": "object",
      "properties": {
        "contact_email": {
          "description": "Parameter the host fills with the user's contact email when the caller\nleaves it out.",
          "type": [
            "string",
            "null"
          ]
        },
        "cpu_parameters": {
          "description": "Parameters that receive the CPU threads granted to the run.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "credentials": {
          "description": "Credential name -> environment variable the plugin reads. A need, never\npermission: an installed package needs a grant bound to its digest; a\nbundled package receives the credential from the user's environment.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "workflow_stages": {
          "description": "Workflow stage name -> registered operation id, including major version.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "OperationDescriptor": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "effects": {
          "$ref": "#/$defs/Effects"
        },
        "family": {
          "$ref": "#/$defs/ExecutionFamily"
        },
        "host": {
          "description": "Services the host runs around a bundled plugin.",
          "anyOf": [
            {
              "$ref": "#/$defs/HostServices"
            },
            {
              "type": "null"
            }
          ]
        },
        "host_workflow": {
          "description": "A workflow the host runs itself from the stages in `needs`.",
          "type": [
            "string",
            "null"
          ]
        },
        "implementation": {
          "type": "string"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/InputBinding"
          },
          "default": {}
        },
        "name": {
          "type": "string"
        },
        "needs": {
          "$ref": "#/$defs/Needs"
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/OutputBinding"
          },
          "default": {}
        },
        "parameters": true,
        "presentation": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": true,
        "title": {
          "type": "string"
        },
        "version": {
          "description": "Semantic version; breaking behavior/default changes require a new major.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "implementation",
        "title",
        "description",
        "family",
        "parameters",
        "result",
        "effects"
      ]
    },
    "OutputBinding": {
      "type": "object",
      "properties": {
        "bootstrap_exports": {
          "description": "Bootstrap trees named `bootstrap-<run>.nex` may be exported beside the\nexported primary tree when `bootstrap_destination` is `working`.",
          "type": "boolean"
        },
        "collection": {
          "description": "A collection is allocated one directory; members remain relative to it.",
          "type": "boolean",
          "default": false
        },
        "facts": {
          "description": "Facts about the primary member, for its companion file.",
          "$ref": "#/$defs/OutputFacts"
        },
        "max": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "media_type": {
          "type": "string"
        },
        "min": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "primary": {
          "description": "The collection member that holds the main result, such as `tree.nwk`.",
          "type": [
            "string",
            "null"
          ]
        },
        "tree_support": {
          "description": "What the support values on trees in this output mean.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TreeSupportRule"
          }
        },
        "visibility": {
          "$ref": "#/$defs/ArtifactVisibility"
        }
      },
      "additionalProperties": false,
      "required": [
        "media_type",
        "min",
        "max",
        "visibility"
      ]
    },
    "OutputFacts": {
      "description": "Facts an output declares about its primary member. The host writes them,\nmarked as stated, into the member's companion file.",
      "type": "object",
      "properties": {
        "branch_lengths": {
          "description": "What a tree's branch lengths measure.",
          "anyOf": [
            {
              "$ref": "#/$defs/BranchLengths"
            },
            {
              "type": "null"
            }
          ]
        },
        "when": {
          "description": "The facts hold only for runs whose parameters meet this, such as a\ncorrected distance model.",
          "anyOf": [
            {
              "$ref": "#/$defs/ParameterCondition"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ParameterCondition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "parameter": {
              "type": "string"
            },
            "test": {
              "type": "string",
              "const": "equals"
            },
            "value": true
          },
          "additionalProperties": false,
          "required": [
            "test",
            "parameter",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "parameter": {
              "type": "string"
            },
            "test": {
              "type": "string",
              "const": "one_of"
            },
            "values": {
              "type": "array",
              "items": true
            }
          },
          "additionalProperties": false,
          "required": [
            "test",
            "parameter",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "parameter": {
              "type": "string"
            },
            "test": {
              "type": "string",
              "const": "positive"
            }
          },
          "additionalProperties": false,
          "required": [
            "test",
            "parameter"
          ]
        }
      ]
    },
    "QueryDescriptor": {
      "description": "A question the plugin answers without inputs, outputs or a run, such as\nwhich external engines are installed. The host refuses undeclared names\nand checks the answer against `result`.",
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "result": true
      },
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "result"
      ]
    },
    "QueryPreparation": {
      "type": "string",
      "enum": [
        "blast"
      ]
    },
    "RemoteService": {
      "description": "A bundled service that sends data elsewhere: how the host cancels it,\nretains its receipt and freezes what it submits.",
      "type": "object",
      "properties": {
        "lifecycle": {
          "$ref": "#/$defs/LifecyclePolicy"
        },
        "query_preparation": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueryPreparation"
            },
            {
              "type": "null"
            }
          ]
        },
        "retained_query_transformation": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "lifecycle"
      ]
    },
    "SupportKind": {
      "description": "Scientific support semantics supplied by a producer, never guessed from its name.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "unknown",
            "bootstrap",
            "probability"
          ]
        },
        {
          "description": "Percentage support from a method other than ordinary bootstrap.",
          "type": "string",
          "const": "percentage"
        }
      ]
    },
    "TreeSupportRule": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/SupportKind"
        },
        "name": {
          "type": "string"
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParameterCondition"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ]
    }
  }
}
