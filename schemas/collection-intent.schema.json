{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CollectionIntent",
  "description": "Expected members recorded before ordinary collection retention.",
  "type": "object",
  "properties": {
    "members": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "schema": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "schema",
    "members"
  ]
}
