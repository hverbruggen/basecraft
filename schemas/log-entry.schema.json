{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LogEntry",
  "description": "One line of the operation log.",
  "type": "object",
  "properties": {
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "doc": {
      "description": "Project-relative path of the document the op applies to.",
      "type": "string"
    },
    "host": {
      "type": "string"
    },
    "id": {
      "description": "ULID: unique, and sorts by time.",
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/OpResult"
    },
    "session": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/DocState"
    },
    "t": {
      "description": "RFC 3339 UTC.",
      "type": "string"
    },
    "v": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "oneOf": [
    {
      "description": "Open a file. Records its content hash, so replay can check it starts\nfrom the same input.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "doc.open"
        },
        "params": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "description": "Save a document. Records the hash of each file written.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "doc.save"
        },
        "params": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "description": "Replace residues `start..end` with `residues`. Insertions and\ndeletions are replacements with an empty side.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "seq.replace"
        },
        "params": {
          "type": "object",
          "properties": {
            "end": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "residues": {
              "type": "string"
            },
            "start": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "start",
            "end",
            "residues"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "feature.add"
        },
        "params": {
          "type": "object",
          "properties": {
            "feature": {
              "$ref": "#/$defs/Feature"
            }
          },
          "required": [
            "feature"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "feature.remove"
        },
        "params": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "id"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "feature.update"
        },
        "params": {
          "type": "object",
          "properties": {
            "feature": {
              "$ref": "#/$defs/Feature"
            },
            "id": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "id",
            "feature"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "description": "Write residues `start..end` and the annotations within them to a new\nfile at `path`. Annotations cut by the range are clipped and marked\nincomplete at the cut. Records the new file's hash.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "doc.extract"
        },
        "params": {
          "type": "object",
          "properties": {
            "end": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "path": {
              "type": "string"
            },
            "reverse": {
              "description": "Write the reverse complement, so a reverse-strand annotation\nreads 5' to 3' in the new file.",
              "type": "boolean"
            },
            "segments": {
              "description": "Parts to splice together, 5' to 3', instead of `start..end`.",
              "type": "array",
              "items": {
                "type": "array",
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  }
                ]
              }
            },
            "start": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "start",
            "end",
            "path"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "description": "Replace columns `start..end` of one row with `residues`.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "aln.replace"
        },
        "params": {
          "type": "object",
          "properties": {
            "end": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "residues": {
              "type": "string"
            },
            "row": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "start": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "row",
            "start",
            "end",
            "residues"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "description": "Insert `residues` before column `col` in `rows`. Like gaps, they use\nup each row's trailing gaps first, unless every row gets them.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "aln.insert"
        },
        "params": {
          "type": "object",
          "properties": {
            "col": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "residues": {
              "type": "string"
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                  },
                  {
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                  }
                ]
              }
            }
          },
          "required": [
            "rows",
            "col",
            "residues"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "description": "Type one residue, or a gap, over the block `rows` × `start..end`.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "aln.fill"
        },
        "params": {
          "type": "object",
          "properties": {
            "end": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "residue": {
              "type": "string"
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                  },
                  {
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                  }
                ]
              }
            },
            "start": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "rows",
            "start",
            "end",
            "residue"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "description": "Insert `count` gaps before column `col`. Rows use up their own\ntrailing gaps first, unless every row gets gaps: that's a new column.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "aln.insert_gaps"
        },
        "params": {
          "type": "object",
          "properties": {
            "col": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "count": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                  },
                  {
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                  }
                ]
              }
            }
          },
          "required": [
            "rows",
            "col",
            "count"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "description": "Delete columns `start..end` of `rows`; what follows moves left.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "aln.delete"
        },
        "params": {
          "type": "object",
          "properties": {
            "end": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                  },
                  {
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                  }
                ]
              }
            },
            "start": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "rows",
            "start",
            "end"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "description": "Slide the block `rows` × `start..end` by `by` columns into the gaps\nbeside it.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "aln.shift"
        },
        "params": {
          "type": "object",
          "properties": {
            "by": {
              "type": "integer",
              "format": "int64"
            },
            "end": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                  },
                  {
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                  }
                ]
              }
            },
            "start": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "rows",
            "start",
            "end",
            "by"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "description": "Delete every column that is a gap in all rows.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "aln.remove_gap_columns"
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "description": "Move `rows`, in order, so the first lands at index `to` among the\nrows that remain.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "aln.move_rows"
        },
        "params": {
          "type": "object",
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                  },
                  {
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                  }
                ]
              }
            },
            "to": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "rows",
            "to"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "aln.rename_row"
        },
        "params": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "row": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "row",
            "name"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "aln.remove_rows"
        },
        "params": {
          "type": "object",
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                  },
                  {
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                  }
                ]
              }
            }
          },
          "required": [
            "rows"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "description": "Root the tree halfway along the branch above `clade`.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "tree.reroot"
        },
        "params": {
          "type": "object",
          "properties": {
            "clade": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "clade"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "description": "Reverse the order of the clade's children.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "tree.rotate"
        },
        "params": {
          "type": "object",
          "properties": {
            "clade": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "clade"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "description": "Order every node's children by size: smallest first (on top), or\nlargest first.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "tree.ladderize"
        },
        "params": {
          "type": "object",
          "properties": {
            "small_first": {
              "type": "boolean"
            }
          },
          "required": [
            "small_first"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "tree.rename_tip"
        },
        "params": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            }
          },
          "required": [
            "from",
            "to"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "description": "Add, change (same `id`) or, with no annotation, remove a clade\nannotation.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "tree.annotate"
        },
        "params": {
          "type": "object",
          "properties": {
            "annotation": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CladeAnnotation"
                },
                {
                  "type": "null"
                }
              ]
            },
            "id": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "id"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "description": "A set of support values, such as bootstraps from another analysis:\none per internal node in preorder, as text.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "tree.add_support"
        },
        "params": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "source": {
              "description": "Where the values came from, for the record.",
              "type": "string",
              "default": ""
            },
            "values": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "required": [
            "name",
            "values"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "tree.remove_support"
        },
        "params": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "tree.style"
        },
        "params": {
          "type": "object",
          "properties": {
            "style": {
              "$ref": "#/$defs/TreeStyle"
            }
          },
          "required": [
            "style"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "description": "A figure or other derived file written from a document, such as a\ntree as SVG. The result holds its hash; replay doesn't rewrite it.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "doc.export"
        },
        "params": {
          "type": "object",
          "properties": {
            "format": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "format"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "description": "A plugin operation that reads and writes files, such as an aligner.\n`inputs` and `outputs` are project-relative paths; the result holds\ntheir content hashes. The actor names the tool and its version.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "tool.run"
        },
        "params": {
          "type": "object",
          "properties": {
            "inputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "operation": {
              "type": "string"
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "params": {
              "default": null
            },
            "plugin": {
              "type": "string"
            }
          },
          "required": [
            "plugin",
            "operation",
            "inputs",
            "outputs"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "description": "Undo the operation with log id `of`.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "history.undo"
        },
        "params": {
          "type": "object",
          "properties": {
            "of": {
              "type": "string"
            }
          },
          "required": [
            "of"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    },
    {
      "description": "Redo the operation with log id `of`.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "history.redo"
        },
        "params": {
          "type": "object",
          "properties": {
            "of": {
              "type": "string"
            }
          },
          "required": [
            "of"
          ]
        }
      },
      "required": [
        "op",
        "params"
      ]
    }
  ],
  "required": [
    "v",
    "id",
    "t",
    "host",
    "session",
    "actor",
    "doc",
    "state"
  ],
  "$defs": {
    "Actor": {
      "description": "Who made a change.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "human"
            },
            "user": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "user"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tool"
            },
            "tool": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "tool",
            "version"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "plugin"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "version"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "agent"
            },
            "model": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "model"
          ]
        },
        {
          "description": "A change Basecraft detected on disk but didn't make.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "external"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "CladeAnnotation": {
      "description": "A highlighted clade: a name on its stem branch, a bar along its tips, a\nfield of colour behind it, or any mix of these.",
      "type": "object",
      "properties": {
        "bar": {
          "description": "Draw a bar along the clade's tips, labelled beside it.",
          "type": "boolean",
          "default": false
        },
        "bar_width": {
          "description": "Bar thickness in pixels.",
          "type": "integer",
          "format": "uint32",
          "default": 3,
          "minimum": 0
        },
        "clade": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "colour": {
          "description": "`#rrggbb`, for the bar and the field.",
          "type": "string",
          "default": "#808080"
        },
        "field": {
          "description": "Fill the area the clade covers.",
          "type": "boolean",
          "default": false
        },
        "label": {
          "type": "string",
          "default": ""
        },
        "on_branch": {
          "description": "Write the label on the clade's stem branch.",
          "type": "boolean",
          "default": false
        },
        "opacity_left": {
          "description": "The field's opacity at its left and right edges, in percent. Two\ndifferent values make a gradient.",
          "type": "integer",
          "format": "uint8",
          "default": 30,
          "maximum": 255,
          "minimum": 0
        },
        "opacity_right": {
          "type": "integer",
          "format": "uint8",
          "default": 30,
          "maximum": 255,
          "minimum": 0
        }
      },
      "required": [
        "clade"
      ]
    },
    "DocState": {
      "description": "A cheap fingerprint of a document after an operation. Replay compares\nit at every step; full content hashes are compared at open and save.",
      "type": "object",
      "properties": {
        "features": {
          "description": "Annotations: features of a sequence, clade annotations of a tree.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "len": {
          "description": "Residues of a sequence, columns of an alignment, tips of a tree.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "rows": {
          "description": "Rows of an alignment.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "len",
        "features"
      ]
    },
    "Feature": {
      "description": "A feature: a type, a location and qualifiers. GFF3 attributes map to\nqualifiers too, with `ID` and `Parent` kept as ordinary qualifiers.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Qualifier"
          }
        }
      },
      "required": [
        "kind",
        "location",
        "qualifiers"
      ]
    },
    "Location": {
      "description": "A feature location: segments in biological order, 5' to 3' of the\nfeature. A reverse-strand two-exon gene lists its downstream exon first.\nLocations crossing the origin of a circular sequence are split into two\nsegments at the origin.",
      "type": "object",
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Segment"
          }
        },
        "unordered": {
          "description": "GenBank `order()`: the segments' order is unknown, as opposed to\n`join()`, where they are joined in the given order.",
          "type": "boolean"
        }
      },
      "required": [
        "segments"
      ]
    },
    "OpResult": {
      "type": "object",
      "properties": {
        "feature": {
          "description": "Id assigned to a new feature.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "hashes": {
          "description": "Content hashes of files read or written, by project-relative path.",
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ]
          }
        }
      }
    },
    "Qualifier": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "description": "`None` for flag qualifiers like GenBank `/pseudo`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "key"
      ]
    },
    "Segment": {
      "description": "One contiguous piece of a feature's location.",
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "partial_end": {
          "description": "The feature extends beyond `end` (GenBank `>`).",
          "type": "boolean"
        },
        "partial_start": {
          "description": "The feature extends beyond `start` (GenBank `<`).",
          "type": "boolean"
        },
        "start": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "strand": {
          "$ref": "#/$defs/Strand"
        }
      },
      "required": [
        "start",
        "end",
        "strand"
      ]
    },
    "Strand": {
      "type": "string",
      "enum": [
        "forward",
        "reverse",
        "unstranded"
      ]
    },
    "SupportPlacement": {
      "description": "Where support values sit relative to their branch.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "above",
            "below"
          ]
        },
        {
          "description": "Above branches that go up from their parent, below those that go\ndown.",
          "type": "string",
          "const": "natural"
        }
      ]
    },
    "SupportSymbols": {
      "description": "Support shown as filled circles at nodes: dark at or above `high`\npercent, grey at or above `low`, white below, as in many published\ntrees. Proportions count as percentages, as for `support_min`.",
      "type": "object",
      "properties": {
        "high": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "low": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "set": {
          "description": "The support set the circles show.",
          "type": "string"
        }
      },
      "required": [
        "set",
        "high",
        "low"
      ]
    },
    "TreeStyle": {
      "description": "How a tree is drawn. Sizes are pixels at 100 % zoom.",
      "type": "object",
      "properties": {
        "branch_width": {
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        },
        "scale_bar": {
          "type": "boolean",
          "default": true
        },
        "support_font": {
          "type": "integer",
          "format": "uint32",
          "default": 10,
          "minimum": 0
        },
        "support_min": {
          "description": "Hide support values below this percentage. Sets whose values are\nall at most 1, such as posterior probabilities, count as\nproportions. 0 shows them all.",
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "support_placement": {
          "$ref": "#/$defs/SupportPlacement",
          "default": "natural"
        },
        "support_shown": {
          "description": "Support sets shown at nodes, in order, joined with \"/\". Empty shows\nevery set.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "symbols": {
          "anyOf": [
            {
              "$ref": "#/$defs/SupportSymbols"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tip_font": {
          "type": "integer",
          "format": "uint32",
          "default": 13,
          "minimum": 0
        },
        "vertical_bar_labels": {
          "description": "Write clade labels beside bars top to bottom, rather than across.",
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
