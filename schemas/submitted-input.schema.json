{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SubmittedInput",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/InputReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "$ref": "#/$defs/EvidenceState"
    },
    "submitted_hash": {
      "type": "string"
    },
    "submitted_size": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "transformation": {
      "description": "canonical-fasta-v1 or ungapped-fasta-v1; generated inputs retain their bytes.",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "schema_version",
    "submitted_hash",
    "submitted_size",
    "transformation",
    "state"
  ],
  "$defs": {
    "EvidenceState": {
      "description": "Unknown states remain readable and serialize without losing their spelling.",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "referenced",
            "generated",
            "preserved",
            "broken"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "FileStamp": {
      "description": "Cheap change signal captured during an existing verified read. Matching time\nand length alone do not prove content identity.",
      "type": "object",
      "properties": {
        "device": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "inode": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "modified_nanos": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "modified_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "size",
        "modified_seconds",
        "modified_nanos"
      ]
    },
    "InputReference": {
      "type": "object",
      "properties": {
        "hash": {
          "description": "Source bytes hash reused from the verified document read.",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "stamp": {
          "$ref": "#/$defs/FileStamp"
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "stamp",
        "hash"
      ]
    }
  }
}
