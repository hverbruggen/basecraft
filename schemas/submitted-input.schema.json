{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunInput",
  "type": "object",
  "properties": {
    "analysis_run": {
      "type": [
        "string",
        "null"
      ]
    },
    "basecraft": {
      "description": "The basecraft version that wrote this file.",
      "type": "string"
    },
    "origin_run": {
      "description": "The earlier run, relative to this one, that holds the preserved original.",
      "type": [
        "string",
        "null"
      ]
    },
    "proposal_target": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/InputReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "$ref": "#/$defs/InputState"
    },
    "submitted_hash": {
      "type": "string"
    },
    "submitted_size": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "transformation": {
      "$ref": "#/$defs/Transformation"
    },
    "upstream": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UpstreamLink"
      }
    }
  },
  "additionalProperties": true,
  "required": [
    "schema_version",
    "submitted_hash",
    "submitted_size",
    "transformation",
    "state",
    "basecraft"
  ],
  "$defs": {
    "FileStamp": {
      "description": "Cheap change signal captured during an existing verified read. Matching time\nand length alone do not prove content identity.",
      "type": "object",
      "properties": {
        "device": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "inode": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "modified_nanos": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "modified_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "size",
        "modified_seconds",
        "modified_nanos"
      ]
    },
    "InputReference": {
      "type": "object",
      "properties": {
        "hash": {
          "description": "Source bytes hash reused from the verified document read.",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "stamp": {
          "$ref": "#/$defs/FileStamp"
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "stamp",
        "hash"
      ]
    },
    "InputState": {
      "description": "What became of the file a run read: still referenced where it was, made\nby basecraft rather than read from a file, kept as a copy beside the run\nafter the file changed, or marked broken by the user's answer to a save.",
      "type": "string",
      "enum": [
        "referenced",
        "generated",
        "preserved",
        "broken"
      ]
    },
    "Transformation": {
      "description": "How the bytes a run was given were made from its input: the file's own\nbytes (`identity-v1`), canonical or ungapped FASTA, canonical Newick, a\nprepared BLAST query, or a sequence snapshot.",
      "type": "string",
      "enum": [
        "identity-v1",
        "canonical-fasta-v1",
        "ungapped-fasta-v1",
        "canonical-newick-v1",
        "blast-query-preparation-v1",
        "sequence-arrow-buffers-v1"
      ]
    },
    "UpstreamLink": {
      "type": "object",
      "properties": {
        "bundle": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "bundle",
        "hash",
        "id"
      ]
    }
  }
}
