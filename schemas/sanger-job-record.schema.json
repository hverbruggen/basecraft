{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SangerJobRecord",
  "description": "Execution and job-index share this shape. Recovery omits `artifact_run`.\nIn `.basecraft/jobs`, paths are relative to the home that holds that\n`.basecraft`, `/`-separated.",
  "type": "object",
  "properties": {
    "artifact_run": {
      "type": [
        "string",
        "null"
      ]
    },
    "basecraft": {
      "description": "The basecraft version that wrote this file.",
      "type": "string"
    },
    "diagnostics": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "owner_instance": {
      "type": "string"
    },
    "primary_output": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "source": {
      "$ref": "#/$defs/SangerJobSource"
    },
    "started": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/SangerJobStatus"
    }
  },
  "additionalProperties": true,
  "required": [
    "schema_version",
    "id",
    "owner_instance",
    "status",
    "operation",
    "started",
    "source",
    "outputs",
    "basecraft"
  ],
  "$defs": {
    "SangerJobSource": {
      "type": "object",
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "SangerJobStatus": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "running",
            "failed",
            "cancelled",
            "interrupted",
            "support_retained",
            "review_requires_attention"
          ]
        },
        {
          "type": "string"
        }
      ]
    }
  }
}
