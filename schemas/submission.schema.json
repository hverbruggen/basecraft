{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Submission",
  "type": "object",
  "properties": {
    "accession_policy": {
      "$ref": "#/$defs/AccessionPolicy"
    },
    "accessions": {
      "description": "Accessions returned by the archive, by record name.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/AccessionEntry"
      }
    },
    "basecraft": {
      "description": "The basecraft version that wrote this file.",
      "type": "string"
    },
    "batch": {
      "$ref": "#/$defs/BatchSettings"
    },
    "destination": {
      "$ref": "#/$defs/Destination",
      "default": "genbank"
    },
    "export": {
      "$ref": "#/$defs/ExportSettings",
      "default": {
        "trim_terminal_unknown": true
      }
    },
    "exported": {
      "description": "Identity mappings from successfully written packages; independent of row selection.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExportMapping"
      }
    },
    "frames": {
      "description": "Reading frames the user confirmed or chose, by record name.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/FrameChoice"
      }
    },
    "marker_drafts": {
      "description": "Marker-specific drafts survive type switches without transferring scientific text.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Marker"
      }
    },
    "publication": {
      "$ref": "#/$defs/Publication",
      "default": {
        "authors": [],
        "title": ""
      }
    },
    "publication_differs": {
      "type": "boolean"
    },
    "row_rules": {
      "description": "Rule origin for explicit decisions; absent entries are manual decisions.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/InclusionRule"
      }
    },
    "rows": {
      "description": "Explicit decisions by record name; absent rows use accession-aware defaults.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/RowDecision"
      }
    },
    "selection_confirmation": {
      "description": "Fingerprint of the reviewed source, effective decisions and accession evidence.",
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "description": "The alignment the records are extracted from.",
      "anyOf": [
        {
          "$ref": "#/$defs/SourceAlignment"
        },
        {
          "type": "null"
        }
      ]
    },
    "submission_details": {
      "description": "Absent until set separately; the publication is then also the submission citation.",
      "anyOf": [
        {
          "$ref": "#/$defs/Publication"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": true,
  "required": [
    "version",
    "batch",
    "basecraft"
  ],
  "$defs": {
    "AccessionEntry": {
      "type": "object",
      "properties": {
        "accession": {
          "description": "Accession, with its version when the archive gave one.",
          "type": "string"
        },
        "record": {
          "type": "string"
        }
      },
      "required": [
        "record",
        "accession"
      ]
    },
    "AccessionPolicy": {
      "description": "Where accession candidates come from. Configured sources keep specimen\nidentifiers elsewhere in a name from influencing inclusion suggestions.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "include_metadata": {
              "type": "boolean"
            },
            "input": {
              "anyOf": [
                {
                  "$ref": "#/$defs/IdentifierSource"
                },
                {
                  "type": "null"
                }
              ]
            },
            "policy": {
              "type": "string",
              "const": "configured"
            }
          },
          "required": [
            "policy",
            "include_metadata"
          ]
        }
      ]
    },
    "Author": {
      "type": "object",
      "properties": {
        "first": {
          "type": "string"
        },
        "last": {
          "type": "string"
        },
        "middle": {
          "description": "Middle names or initials, without the first name's, such as `Marie` or `M.R.`.\nBare uppercase runs (`MR`) are initials; uppercase full names are ambiguous.",
          "type": "string"
        }
      },
      "required": [
        "first",
        "last"
      ]
    },
    "BatchSettings": {
      "description": "Settings shared by every record of the batch.",
      "type": "object",
      "properties": {
        "ends": {
          "$ref": "#/$defs/EndPolicy",
          "default": "auto"
        },
        "genetic_code": {
          "description": "NCBI genetic code (translation table) number. None until someone\nchooses one: a coding marker can't be checked or exported without it.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "marker": {
          "$ref": "#/$defs/Marker"
        },
        "mol_type": {
          "$ref": "#/$defs/MolType",
          "default": "genomic_dna"
        },
        "organelle": {
          "description": "The organelle the marker is from; none for nuclear markers.",
          "anyOf": [
            {
              "$ref": "#/$defs/Organelle"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "marker"
      ]
    },
    "Destination": {
      "type": "string",
      "enum": [
        "genbank"
      ]
    },
    "EndPolicy": {
      "description": "How the feature's ends are marked.",
      "oneOf": [
        {
          "description": "Coding markers: an end is complete when it has a start (5') or stop\n(3') codon in frame. Other markers: both ends partial.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "Both ends partial.",
          "type": "string",
          "const": "partial"
        },
        {
          "description": "Both ends complete.",
          "type": "string",
          "const": "complete"
        }
      ]
    },
    "ExportMapping": {
      "description": "Retained identities for interpreting archive returns after later selection edits.",
      "type": "object",
      "properties": {
        "records": {
          "description": "Submitted `SeqID` to original biological record name.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceAlignment"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "records"
      ]
    },
    "ExportSettings": {
      "type": "object",
      "properties": {
        "trim_terminal_unknown": {
          "description": "Remove runs of unknown bases (N, ?) at the ends of each record.\nThe trimmed lengths are recorded in the coordinate map.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "FrameChoice": {
      "description": "A reading frame the user reviewed for one record.",
      "type": "object",
      "properties": {
        "codon_start": {
          "description": "1, 2 or 3: the first base of the first complete codon.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "record": {
          "type": "string"
        }
      },
      "required": [
        "record",
        "codon_start"
      ]
    },
    "IdentifierSource": {
      "description": "Identifier fields use the same literal splitting primitive as metadata header imports.\nSubmission rules always use the FASTA identifier, never the full description header.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "identifier"
            }
          },
          "required": [
            "source"
          ]
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "separator": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "const": "field"
            }
          },
          "required": [
            "source",
            "separator",
            "index"
          ]
        }
      ]
    },
    "InclusionAction": {
      "type": "string",
      "enum": [
        "include",
        "exclude",
        "unchanged"
      ]
    },
    "InclusionRule": {
      "type": "object",
      "properties": {
        "case_sensitive": {
          "type": "boolean",
          "default": false
        },
        "input": {
          "$ref": "#/$defs/IdentifierSource"
        },
        "matching": {
          "$ref": "#/$defs/InclusionAction"
        },
        "mode": {
          "$ref": "#/$defs/MatchMode"
        },
        "name": {
          "type": "string"
        },
        "nonmatching": {
          "$ref": "#/$defs/InclusionAction"
        },
        "override_manual": {
          "type": "boolean",
          "default": false
        },
        "pattern": {
          "type": "string"
        },
        "trim": {
          "type": "boolean",
          "default": false
        },
        "unresolved": {
          "$ref": "#/$defs/InclusionAction",
          "default": "unchanged"
        }
      },
      "required": [
        "name",
        "input",
        "mode",
        "pattern",
        "matching",
        "nonmatching"
      ]
    },
    "ItsComponent": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "ITS1",
            "5.8S",
            "ITS2"
          ]
        },
        {
          "description": "Small subunit (18S) ribosomal RNA.",
          "type": "string",
          "const": "SSU"
        },
        {
          "description": "Large subunit (28S) ribosomal RNA.",
          "type": "string",
          "const": "LSU"
        }
      ]
    },
    "Marker": {
      "description": "The marker type, which decides the one feature each record gets.",
      "oneOf": [
        {
          "description": "A protein-coding gene: a `gene` and a `CDS` feature.",
          "type": "object",
          "properties": {
            "gene": {
              "description": "Gene symbol, such as `rbcL`; may be empty.",
              "type": "string",
              "default": ""
            },
            "kind": {
              "type": "string",
              "const": "coding"
            },
            "product": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "product"
          ]
        },
        {
          "description": "A ribosomal RNA gene, such as `18S ribosomal RNA`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rrna"
            },
            "product": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "product"
          ]
        },
        {
          "description": "The ITS region: one `misc_RNA` with a note listing the components\npresent. Internal boundaries are not annotated.",
          "type": "object",
          "properties": {
            "components": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ItsComponent"
              }
            },
            "kind": {
              "type": "string",
              "const": "its"
            }
          },
          "required": [
            "kind",
            "components"
          ]
        },
        {
          "description": "A non-coding region, such as an intergenic spacer: one\n`misc_feature` with this description as its note.",
          "type": "object",
          "properties": {
            "description": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "spacer"
            }
          },
          "required": [
            "kind",
            "description"
          ]
        }
      ]
    },
    "MatchMode": {
      "type": "string",
      "enum": [
        "exact",
        "contains",
        "starts",
        "ends",
        "wildcard",
        "regex"
      ]
    },
    "MolType": {
      "type": "string",
      "enum": [
        "genomic_dna",
        "genomic_rna"
      ]
    },
    "Organelle": {
      "type": "string",
      "enum": [
        "mitochondrion",
        "chloroplast",
        "plastid",
        "apicoplast",
        "chromoplast",
        "cyanelle",
        "kinetoplast",
        "nucleomorph"
      ]
    },
    "Publication": {
      "description": "The publication the sequences belong to, written to the `.sbt`.",
      "type": "object",
      "properties": {
        "authors": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Author"
          }
        },
        "title": {
          "type": "string",
          "default": ""
        }
      }
    },
    "RowDecision": {
      "description": "What to do with a row.",
      "type": "object",
      "properties": {
        "record": {
          "description": "The alignment row name (FASTA ID).",
          "type": "string"
        }
      },
      "oneOf": [
        {
          "description": "A newly generated sequence, exported for submission.",
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "new"
            }
          },
          "required": [
            "decision"
          ]
        },
        {
          "description": "Already in an archive (a downloaded reference, or submitted\nbefore); not exported.",
          "type": "object",
          "properties": {
            "accession": {
              "type": "string"
            },
            "decision": {
              "type": "string",
              "const": "existing"
            }
          },
          "required": [
            "decision",
            "accession"
          ]
        },
        {
          "description": "Left out of the submission.",
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "exclude"
            }
          },
          "required": [
            "decision"
          ]
        }
      ],
      "required": [
        "record"
      ]
    },
    "SourceAlignment": {
      "description": "An alignment file inside the project and the BLAKE3 hash of the bytes\nthe submission was prepared from. A different file content is refused\nuntil the source is selected again.",
      "type": "object",
      "properties": {
        "document": {
          "description": "Project-relative path.",
          "type": "string"
        },
        "hash": {
          "type": "string"
        }
      },
      "required": [
        "document",
        "hash"
      ]
    }
  }
}
