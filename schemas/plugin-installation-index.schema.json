{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InstallationIndex",
  "description": "Plugin selections and retained runtimes.\nThe payload parameter preserves the host's behavior-bearing runtime wrapper.",
  "type": "object",
  "properties": {
    "active": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "basecraft": {
      "description": "The basecraft version that wrote this file.",
      "type": "string"
    },
    "disabled": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "editable": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "runtimes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Runtime"
      }
    },
    "schema": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "schema",
    "active",
    "runtimes",
    "disabled",
    "editable",
    "basecraft"
  ],
  "$defs": {
    "Runtime": {
      "description": "Retained managed-runtime receipt. The host verifies its paths and digests.",
      "type": "object",
      "properties": {
        "executable_digests": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "executables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interpreter": {
          "type": "string"
        },
        "lock_digest": {
          "type": "string"
        },
        "manifest_digest": {
          "type": "string"
        },
        "package_digest": {
          "type": "string"
        },
        "reported_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "root": {
          "type": "string"
        },
        "schema": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "schema",
        "executables",
        "root",
        "interpreter",
        "lock_digest",
        "manifest_digest",
        "package_digest",
        "reported_versions",
        "executable_digests"
      ]
    }
  }
}
