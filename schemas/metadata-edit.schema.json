{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MetadataEdit",
  "description": "One atomic metadata edit.",
  "oneOf": [
    {
      "description": "Add or replace a project partition using the shared hypothesis model.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "put_partition"
        },
        "partition": {
          "$ref": "#/$defs/Hypothesis"
        }
      },
      "required": [
        "action",
        "partition"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "remove_partition"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "apply"
        },
        "changes": {
          "$ref": "#/$defs/ChangeSet"
        }
      },
      "required": [
        "action",
        "changes"
      ]
    },
    {
      "description": "Refused while a removed specimen has identifications or links.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "remove_specimens"
        },
        "specimens": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "action",
        "specimens"
      ]
    },
    {
      "description": "Remove a column and its values.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "remove_column"
        },
        "column": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "column"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "unlink"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecordRef"
          }
        }
      },
      "required": [
        "action",
        "records"
      ]
    },
    {
      "description": "Withdraw identifications recorded in error. Re-identification adds a\nnew identification instead.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "remove_identifications"
        },
        "identifications": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "action",
        "identifications"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "set_import_settings"
        },
        "settings": {
          "$ref": "#/$defs/ImportSettings"
        }
      },
      "required": [
        "action",
        "settings"
      ]
    }
  ],
  "$defs": {
    "Cell": {
      "description": "One value. The variant must match its column's kind; any column may hold\na missing-value reason instead.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "date": {
              "$ref": "#/$defs/PartialDate"
            }
          },
          "additionalProperties": false,
          "required": [
            "date"
          ]
        },
        {
          "description": "Latitude or longitude in decimal degrees.",
          "type": "object",
          "properties": {
            "degrees": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "degrees"
          ]
        },
        {
          "type": "object",
          "properties": {
            "number": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "number"
          ]
        },
        {
          "type": "object",
          "properties": {
            "category": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "category"
          ]
        },
        {
          "type": "object",
          "properties": {
            "missing": {
              "$ref": "#/$defs/MissingReason"
            }
          },
          "additionalProperties": false,
          "required": [
            "missing"
          ]
        }
      ]
    },
    "CellChange": {
      "description": "One value to set, or with no value, to clear.",
      "type": "object",
      "properties": {
        "column": {
          "type": "string"
        },
        "specimen": {
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cell"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "specimen",
        "column"
      ]
    },
    "ChangeSet": {
      "description": "Additions and updates applied together: one undo step. Every import\nroute produces one, reviewed before it is applied.",
      "type": "object",
      "properties": {
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CellChange"
          }
        },
        "columns": {
          "description": "New specimen columns.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Column"
          }
        },
        "identifications": {
          "description": "Appended identifications.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identification"
          }
        },
        "links": {
          "description": "New links, or replacements for a record's existing link.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecordLink"
          }
        },
        "specimens": {
          "description": "New specimen IDs, appended to the roster.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "taxa": {
          "description": "New taxa, or replacements for taxa with the same ID.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Taxon"
          }
        }
      }
    },
    "Column": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ColumnKind"
        },
        "name": {
          "description": "A Darwin Core term (`catalogNumber`, `eventDate`, ...) or a user name:\nan ASCII letter followed by letters, digits or underscores.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind"
      ]
    },
    "ColumnKind": {
      "description": "What a column holds. Every kind also accepts an INSDC missing-value reason.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "A calendar date at its true precision: year, year and month, or day.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "date"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "WGS84 decimal degrees, -90 to 90.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "latitude"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "WGS84 decimal degrees, -180 to 180.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "longitude"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "A number, in `unit` when given.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "number"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "One of `levels`.",
          "type": "object",
          "properties": {
            "levels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "const": "categorical"
            }
          },
          "required": [
            "type",
            "levels"
          ]
        }
      ]
    },
    "FieldTarget": {
      "description": "What an imported field holds.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "const": "ignore"
            }
          },
          "required": [
            "role"
          ]
        },
        {
          "description": "The specimen's local ID: the key that rows are matched on.",
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "const": "specimen"
            }
          },
          "required": [
            "role"
          ]
        },
        {
          "description": "A sequence record ID to link to the row's specimen.",
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "const": "record"
            }
          },
          "required": [
            "role"
          ]
        },
        {
          "description": "A taxon name; the specimen is identified as that taxon.",
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "const": "taxon"
            }
          },
          "required": [
            "role"
          ]
        },
        {
          "description": "A value for a specimen column.",
          "type": "object",
          "properties": {
            "column": {
              "type": "string"
            },
            "role": {
              "type": "string",
              "const": "column"
            }
          },
          "required": [
            "role",
            "column"
          ]
        }
      ]
    },
    "Group": {
      "type": "object",
      "properties": {
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "color": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "individual_scores": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Score"
            }
          },
          "default": {}
        },
        "label": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "scores": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Score"
          }
        }
      },
      "required": [
        "id",
        "label",
        "color",
        "members"
      ]
    },
    "HeaderPattern": {
      "description": "How to read fields from structured FASTA headers, such as\n`HV1234|Caulerpa taxifolia|2019-05-12`.",
      "type": "object",
      "properties": {
        "fields": {
          "description": "What each field holds, in order. Fields past the end are ignored.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldTarget"
          }
        },
        "name": {
          "type": "string"
        },
        "separator": {
          "description": "Splits the header line (without `>`). Must not be empty.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "separator",
        "fields"
      ]
    },
    "Hypothesis": {
      "type": "object",
      "properties": {
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Group"
          }
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/HypothesisOrigin"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "scores": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Score"
          }
        },
        "unassigned": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "name",
        "origin",
        "groups",
        "unassigned",
        "provenance"
      ]
    },
    "HypothesisOrigin": {
      "type": "string",
      "enum": [
        "manual",
        "imported",
        "inferred",
        "derived",
        "manual_cut"
      ]
    },
    "Identification": {
      "description": "A recorded assignment of a specimen to a taxon. Re-identification adds\nanother; it never overwrites the earlier one.",
      "type": "object",
      "properties": {
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "identified_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "remarks": {
          "type": [
            "string",
            "null"
          ]
        },
        "specimen": {
          "type": "string"
        },
        "taxon": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "specimen",
        "taxon"
      ]
    },
    "ImportSettings": {
      "description": "Saved import settings, so a project's next import repeats its last one.",
      "type": "object",
      "properties": {
        "header_patterns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HeaderPattern"
          }
        },
        "spreadsheet_mappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpreadsheetMapping"
          }
        }
      }
    },
    "JobStatus": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "cancelled",
        "unavailable"
      ]
    },
    "MissingReason": {
      "description": "Why a value is missing: the INSDC missing-value vocabulary, written as\nINSDC writes it.",
      "type": "string",
      "enum": [
        "not applicable",
        "missing",
        "not collected",
        "not provided",
        "restricted access",
        "missing: control sample",
        "missing: sample group",
        "missing: synthetic construct",
        "missing: lab stock",
        "missing: third party data",
        "missing: data agreement established pre-2023",
        "missing: endangered species",
        "missing: human-identifiable"
      ]
    },
    "PartialDate": {
      "description": "A date at year, month or day precision",
      "type": "string",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "analysis_tree": {
          "type": [
            "string",
            "null"
          ]
        },
        "diagnostics": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "haplotypes": {
          "description": "Representative ID to original specimen IDs; never likelihood weights.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "default": {}
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "method": {
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "string"
        },
        "workers": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "method",
        "version"
      ]
    },
    "RecordLink": {
      "description": "A stored link from a sequence record to the specimen it came from. Many\nrecords may link to one specimen. Links are made at import and never\nre-derived from names.",
      "type": "object",
      "properties": {
        "document": {
          "type": "string"
        },
        "record": {
          "type": "string"
        },
        "specimen": {
          "type": "string"
        }
      },
      "required": [
        "document",
        "record",
        "specimen"
      ]
    },
    "RecordRef": {
      "description": "A sequence record in a project document.",
      "type": "object",
      "properties": {
        "document": {
          "description": "Project-relative path of the sequence file.",
          "type": "string"
        },
        "record": {
          "description": "The record's ID: its FASTA header up to the first whitespace, or its\nalignment row name.",
          "type": "string"
        }
      },
      "required": [
        "document",
        "record"
      ]
    },
    "Score": {
      "type": "object",
      "properties": {
        "interpretation": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "scale": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "value",
        "method",
        "scale",
        "interpretation"
      ]
    },
    "SpreadsheetMapping": {
      "description": "Remembered spreadsheet column mapping.",
      "type": "object",
      "properties": {
        "columns": {
          "description": "Source column header to what it holds. Unmapped columns are ignored.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/FieldTarget"
          }
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "columns"
      ]
    },
    "Taxon": {
      "description": "A taxon that specimens can be identified as.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "description": "The name used in this project's research.",
          "type": "string"
        },
        "submitted_name": {
          "description": "The name to submit when it differs, such as an informal name for an\nundescribed species (`Caulerpa sp. 3 HV-2026`).",
          "type": [
            "string",
            "null"
          ]
        },
        "taxid": {
          "description": "NCBI Taxonomy ID, when known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "name"
      ]
    }
  }
}
