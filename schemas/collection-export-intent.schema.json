{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CollectionExportIntent",
  "description": "Visible collection destination and members, recorded before copying.",
  "type": "object",
  "properties": {
    "basecraft": {
      "description": "The basecraft version that wrote this file.",
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "members": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "schema": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "schema",
    "destination",
    "members",
    "basecraft"
  ]
}
