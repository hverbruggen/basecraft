{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocumentRecord",
  "type": "object",
  "properties": {
    "document": {
      "type": "string"
    },
    "effective": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EditActivity"
      }
    },
    "events": true,
    "revision": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "unsaved": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "document",
    "revision",
    "unsaved",
    "warnings",
    "events",
    "effective"
  ],
  "$defs": {
    "EditActivity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "operation": {
          "description": "A journal operation; its shape is defined once, in journal-entry.schema.json."
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "operation"
      ]
    }
  }
}
