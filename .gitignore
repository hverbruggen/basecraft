# Build output and environments; personal storage overrides belong in user config.
target/
.pixi/*

# Rust
*.profraw
*.profdata
perf.data*
flamegraph.svg
criterion/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
dist/
build/
*.so

# Qt, C++
*.qmlc
*.jsc
.qmlls.ini
compile_commands.json
.cache/

# Basecraft project state, created when running against test data
.basecraft/

# Only fixtures and generator code live under testdata/.
/testdata/*
!/testdata/fixtures/
!/testdata/generate/
!/testdata/compact/

# Large data formats. Generated test data goes to ~/.cache/basecraft-testdata.
# Small files under testdata/fixtures/ are allowed. The pre-commit hook
# blocks any file over 5 MB, whatever its type.
*.bam
*.bai
*.cram
*.crai
*.sam
*.bcf
*.csi
*.tbi
*.fastq
*.fq
*.gz
*.bgz
*.gzi
*.zst
*.sra
!testdata/fixtures/**

# Local scratch space
/scratch/

# Editors and OS
.idea/
.vscode/
*.swp
*~
*.kate-swp
.DS_Store
.claude/settings.local.json

# Brainstorming notes, kept local until a proper design doc replaces them
/PLAN.md

# Development docs stay local: on disk and in pCloud, not on GitHub.
/docs/
/CLAUDE.md
/methods_research/
