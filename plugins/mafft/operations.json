{
  "schema": 1,
  "operations": [
    {
      "name": "align",
      "version": "1.0.0",
      "implementation": "align",
      "title": "Align sequences with MAFFT",
      "description": "Align sequences with MAFFT. Uses the existing public plugin implementation and declared immutable inputs.",
      "family": "file_analysis",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "threads": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "result": {
        "type": "null"
      },
      "inputs": {
        "alignment": {
          "view": "ungapped_fasta",
          "media_type": "text/x-fasta",
          "min": 1,
          "max": 1
        }
      },
      "outputs": {
        "artifacts": {
          "media_type": "application/vnd.basecraft.artifact-collection",
          "min": 1,
          "max": 1024,
          "visibility": "result",
          "collection": true
        }
      },
      "effects": {
        "document_write": false,
        "artifact_write": true
      },
      "cpu_parameters": [
        "threads"
      ],
      "legacy_adapter": {
        "primary_input": "alignment",
        "inputs": {
          "alignment": "input"
        },
        "input_arrays": [],
        "outputs": {
          "output": {
            "role": "artifacts",
            "path": "alignment.afa"
          }
        },
        "allocation": "artifacts"
      }
    },
    {
      "name": "place_sanger",
