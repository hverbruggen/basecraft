{
  "schema": 1,
  "operations": [
    {
      "name": "tree",
      "version": "1.0.0",
      "implementation": "tree",
      "title": "Infer a tree with FastTree",
      "description": "Infer a tree with FastTree. Uses the existing public plugin implementation and declared immutable inputs.",
      "family": "file_analysis",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": {
            "enum": [
              "GTR",
              "JC",
              "LG",
              "WAG",
              "JTT"
            ]
          },
          "gamma": {
            "type": "boolean",
            "default": false
          },
          "support": {
            "type": "boolean",
            "default": true
          },
          "resamples": {
            "type": "integer",
            "minimum": 1,
            "default": 1000
          }
        }
      },
      "result": {
        "type": "null"
      },
      "inputs": {
        "alignment": {
          "view": "aligned_fasta",
          "media_type": "text/x-fasta",
          "min": 1,
          "max": 1
        }
      },
      "outputs": {
        "artifacts": {
          "media_type": "application/vnd.basecraft.artifact-collection",
          "min": 1,
          "max": 1024,
          "visibility": "result",
          "collection": true
        }
      },
      "effects": {
        "document_write": false,
        "artifact_write": true
      },
      "cpu_parameters": [],
      "legacy_adapter": {
        "primary_input": "alignment",
        "inputs": {
          "alignment": "input"
        },
        "input_arrays": [],
        "outputs": {
          "output": {
            "role": "artifacts",
            "path": "tree.nwk"
          }
        },
        "allocation": "artifacts"
      }
    }
  ]
}
