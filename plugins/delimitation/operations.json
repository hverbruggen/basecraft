    {
      "name": "haplotypes",
      "version": "1.0.0",
      "implementation": "haplotypes",
      "title": "Prepare exact aligned DNA haplotypes",
      "description": "Prepare exact aligned DNA haplotypes. Uses the existing public plugin implementation and declared immutable inputs.",
      "family": "file_analysis",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rooted": {
            "type": "boolean",
            "default": false
          },
          "tree_index": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "seed": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "workers": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          },
          "deduplicate": {
            "type": "boolean",
            "default": false
          },
          "model": {
            "enum": [
              "p",
              "jc69",
              "k2p"
            ],
            "default": "k2p"
          },
          "min_overlap": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          }
        }
      },
      "result": {
        "type": "null"
      },
      "inputs": {
        "alignment": {
          "view": "aligned_fasta",
          "media_type": "application/octet-stream",
          "min": 1,
          "max": 1
        }
      },
      "outputs": {
        "artifacts": {
          "media_type": "application/vnd.basecraft.artifact-collection",
          "min": 1,
          "max": 1024,
          "visibility": "result",
          "collection": true
        }
      },
      "effects": {
        "document_write": false,
        "artifact_write": true
      },
      "cpu_parameters": [
        "workers"
      ],
      "legacy_adapter": {
        "primary_input": "alignment",
        "inputs": {
          "alignment": "input"
        },
        "input_arrays": [],
        "outputs": {
          "output": {
            "role": "artifacts",
            "path": "result.json"
          }
        },
