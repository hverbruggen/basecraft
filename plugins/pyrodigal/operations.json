{
  "schema": 2,
  "operations": [
    {
      "name": "predict_genes",
      "version": "1.0.0",
      "implementation": "predict_genes",
      "title": "Predict genes with Pyrodigal",
      "description": "Predict genes with Pyrodigal. Uses the existing public plugin implementation and declared immutable inputs.",
      "family": "sequence_proposal",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["translation_table"],
        "properties": {
          "translation_table": {
            "description": "NCBI genetic code (translation table). No default.",
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "result": {
        "type": "null"
      },
      "inputs": {
        "sequence": {
          "view": "sequence_snapshot",
          "media_type": "application/vnd.apache.arrow.stream",
          "alphabets": ["dna", "rna"],
          "min": 1,
          "max": 1
        }
      },
      "outputs": {},
      "effects": {
        "document_write": true,
        "artifact_write": false
      }
    }
  ]
}
