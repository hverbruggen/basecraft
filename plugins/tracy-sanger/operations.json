{
  "schema": 2,
  "operations": [
    {
      "name": "consensus",
      "version": "1.0.0",
      "implementation": "consensus",
      "title": "Build a review-only Sanger consensus",
      "description": "Build a review-only Sanger consensus. Uses the existing public plugin implementation and declared immutable inputs.",
      "family": "file_analysis",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "engine_sha256": {
            "type": "string"
          },
          "minimum_overlap": {
            "type": "integer",
            "minimum": 1,
            "default": 50
          },
          "minimum_identity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.8
          },
          "signal_threshold": {
            "type": "integer",
            "minimum": 0,
            "default": 20
          }
        }
      },
      "result": {
        "type": "null"
      },
      "inputs": {
        "reads": {
          "view": "bytes",
          "media_type": "application/x-abif",
          "min": 1,
          "max": 3,
          "retain": true
        }
      },
      "outputs": {
        "artifacts": {
          "media_type": "application/vnd.basecraft.artifact-collection",
          "min": 1,
          "max": 1024,
          "visibility": "result",
          "collection": true,
          "primary": "evidence.json"
        }
      },
      "effects": {
        "document_write": false,
        "artifact_write": true
      },
      "host": {
        "caller": "single_trace"
      }
    },
    {
      "name": "calls",
      "version": "1.0.0",
      "implementation": "calls",
      "title": "Load Tracy calls",
      "description": "Load Tracy calls. Uses the existing public plugin implementation and declared immutable inputs.",
      "family": "file_analysis",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "engine_sha256": {
            "type": "string"
          }
        }
      },
      "result": {
        "type": "null"
      },
      "inputs": {
        "read": {
          "view": "bytes",
          "media_type": "application/x-abif",
          "min": 1,
          "max": 1,
          "retain": true
        }
      },
      "outputs": {
        "artifacts": {
          "media_type": "application/vnd.basecraft.artifact-collection",
          "min": 1,
          "max": 1024,
          "visibility": "result",
          "collection": true,
          "primary": "calls.json"
        }
      },
      "effects": {
        "document_write": false,
        "artifact_write": true
      }
    },
    {
      "name": "primers",
      "version": "1.0.0",
      "implementation": "primers",
      "title": "Find primer candidates",
      "description": "Find primer candidates. Uses the existing public plugin implementation and declared immutable inputs.",
      "family": "file_analysis",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "type": "string"
          },
          "forward": {
            "type": "string",
            "default": ""
          },
          "reverse": {
            "type": "string",
            "default": ""
          },
          "minimum_overlap": {
            "type": "integer",
            "minimum": 1,
            "default": 12
          },
          "error_percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "default": 25
          }
        },
        "required": [
          "sequence"
        ]
      },
      "result": {
        "type": "null"
      },
      "inputs": {},
      "outputs": {
        "artifacts": {
          "media_type": "application/vnd.basecraft.artifact-collection",
          "min": 1,
          "max": 1024,
          "visibility": "result",
          "collection": true,
          "primary": "primers.json"
        }
      },
      "effects": {
        "document_write": false,
        "artifact_write": true
      }
    }
  ],
  "queries": [
    {
      "name": "engine",
      "description": "The base caller program this installation runs: its name and SHA-256, or why it is unavailable.",
      "result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "problem": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "sha256",
          "problem"
        ]
      }
    }
  ]
}
