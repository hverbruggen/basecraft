{
  "schema": 1,
  "operations": [
    {
      "name": "consensus",
      "version": "1.0.0",
      "implementation": "consensus",
      "title": "Build a review-only Sanger consensus",
      "description": "Build a review-only Sanger consensus. Uses the existing public plugin implementation and declared immutable inputs.",
      "family": "file_analysis",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "engine_sha256": {
            "type": "string"
          },
          "minimum_overlap": {
            "type": "integer",
            "minimum": 1,
            "default": 50
          },
          "minimum_identity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.8
          },
          "signal_threshold": {
            "type": "integer",
            "minimum": 0,
            "default": 20
          }
        }
      },
      "result": {
        "type": "null"
      },
      "inputs": {
        "reads": {
          "view": "bytes",
          "media_type": "application/x-abif",
          "min": 1,
          "max": 3,
          "retain": true
        }
      },
      "outputs": {
        "artifacts": {
          "media_type": "application/vnd.basecraft.artifact-collection",
          "min": 1,
          "max": 1024,
          "visibility": "result",
          "collection": true
        }
      },
      "effects": {
        "document_write": false,
        "artifact_write": true
      },
      "cpu_parameters": [],
      "legacy_adapter": {
        "primary_input": "reads",
        "inputs": {
          "reads": "reads"
        },
        "input_arrays": [
          "reads"
        ],
        "outputs": {
          "output": {
            "role": "artifacts",
            "path": "."
          }
        },
        "allocation": null
      },
      "host": {
        "caller": "single_trace"
      }
    },
