{
  "schema": 2,
  "operations": [
    {
      "name": "trim",
      "version": "1.0.0",
      "implementation": "trim",
      "title": "Trim an alignment with trimAl",
      "description": "Trim an alignment with trimAl. Uses the existing public plugin implementation and declared immutable inputs.",
      "family": "file_analysis",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "method": {
            "enum": [
              "automated1",
              "gappyout",
              "strict",
              "strictplus",
              "nogaps"
            ],
            "default": "automated1"
          }
        }
      },
      "result": {
        "type": "null"
      },
      "inputs": {
        "alignment": {
          "view": "aligned_fasta",
          "media_type": "text/x-fasta",
          "min": 1,
          "max": 1
        }
      },
      "outputs": {
        "artifacts": {
          "media_type": "application/vnd.basecraft.artifact-collection",
          "min": 1,
          "max": 1024,
          "visibility": "result",
          "collection": true,
          "primary": "trimmed.afa"
        }
      },
      "effects": {
        "document_write": false,
        "artifact_write": true
      }
    }
  ]
}
