{
  "schema": 2,
  "operations": [
    {
      "name": "find_orfs",
      "version": "1.0.0",
      "implementation": "find_orfs",
      "title": "Find open reading frames",
      "description": "Find open reading frames on both strands: ATG to the next stop codon of the chosen genetic code.",
      "family": "sequence_proposal",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["genetic_code"],
        "properties": {
          "genetic_code": {
            "description": "NCBI genetic code (translation table): its stop codons end an ORF. No default.",
            "type": "integer",
            "enum": [1, 2, 3, 4, 5, 6, 9, 10, 11, 12, 13, 14, 16, 21, 22, 23, 24, 25, 26, 29, 30, 33]
          },
          "min_codons": {
            "type": "integer",
            "minimum": 1,
            "default": 100
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "result": {
        "type": "null"
      },
      "inputs": {
        "sequence": {
          "view": "sequence_snapshot",
          "media_type": "application/vnd.apache.arrow.stream",
          "alphabets": ["dna", "rna"],
          "min": 1,
          "max": 1
        }
      },
      "outputs": {},
      "effects": {
        "document_write": true,
        "artifact_write": false
      }
    }
  ]
}
