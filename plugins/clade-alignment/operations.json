{
  "schema": 1,
  "operations": [
    {
      "name": "extract",
      "version": "1.0.0",
      "implementation": "extract",
      "title": "Extract selected taxa without changing columns",
      "description": "Extract selected taxa without changing columns. Uses the existing public plugin implementation and declared immutable inputs.",
      "family": "file_analysis",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "taxa": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "taxa"
        ]
      },
      "result": {
        "type": "null"
      },
      "inputs": {
        "alignment": {
          "view": "aligned_fasta",
          "media_type": "text/x-fasta",
          "min": 1,
          "max": 1
        },
        "selection_tree": {
          "view": "newick",
          "media_type": "text/x-newick",
          "min": 0,
          "max": 1
        }
      },
      "outputs": {
        "artifacts": {
          "media_type": "application/vnd.basecraft.artifact-collection",
          "min": 1,
          "max": 1024,
          "visibility": "result",
          "collection": true
        }
      },
      "effects": {
        "document_write": false,
        "artifact_write": true
      },
      "cpu_parameters": [],
      "legacy_adapter": {
        "primary_input": "alignment",
        "inputs": {
          "alignment": "input",
          "selection_tree": "selection_tree"
        },
        "input_arrays": [],
        "outputs": {
          "output": {
            "role": "artifacts",
            "path": "clade.afa"
          }
        },
        "allocation": "artifacts"
      }
    }
  ]
}
