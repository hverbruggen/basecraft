# Draft conda-build recipe, deliberately not runnable until native feasibility,
# dependency closure/pins, notices and reported versions have been established.
# Render REVIEWED_* from the native build record, never from an ambient solve.
package:
  name: basecraft-table2asn
  version: "30.8.0"
source:
  url: https://codeload.github.com/ncbi/ncbi-cxx-toolkit-public/tar.gz/01ab652af9da9d557b1553504d4dcd4db12f5b86
  sha256: de56c4be23c50d93edf0014e310471be03bb2c8f114b8b414f99149518201d95
build:
  number: 0
  # Package version identifies the source release, not table2asn -version.
  string: source01ab652_0
requirements:
  build:
    - {{ compiler('c') }}
    - {{ compiler('cxx') }}
    - cmake {{ REVIEWED_CMAKE_PIN }}
    - ninja {{ REVIEWED_NINJA_PIN }}
  host:
    - libxml2 {{ REVIEWED_LIBXML2_PIN }}
    - libxslt {{ REVIEWED_LIBXSLT_PIN }}
    # Add the COMPLETE closure from the native target's configure/link report.
  run:
    - {{ pin_compatible('libxml2', exact=True) }}
    - {{ pin_compatible('libxslt', exact=True) }}
    # Add compiler runtime and every other linked shared dependency.
test:
  commands:
    - table2asn -version
    # Verify exact output and run the common submission fixtures outside this
    # smoke check, on each target. A zero exit alone does not validate semantics.
about:
  home: https://www.ncbi.nlm.nih.gov/genbank/table2asn/
  license: LicenseRef-NCBI-Public-Domain-with-third-party-exceptions
  license_file:
    - LICENSE
    # Add notices for the actual linked closure; see README.md.
  summary: NCBI table2asn built from a common source commit
