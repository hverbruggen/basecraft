#!/usr/bin/env bash
# Fast checks before each commit. `just ci` runs the full set.
set -euo pipefail

# Block large files. Big data belongs in ~/.cache/basecraft-testdata.
limit=$((5 * 1024 * 1024))
too_big=0
while IFS= read -r -d '' f; do
    size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
    if [ "$size" -gt "$limit" ]; then
        echo "pre-commit: $f is $((size / 1024 / 1024)) MB, over the 5 MB limit" >&2
        too_big=1
    fi
done < <(git diff --cached --name-only --diff-filter=AM -z)
[ "$too_big" -eq 0 ] || exit 1

cargo fmt --all --check
cargo clippy --workspace --all-targets --quiet -- -D warnings
